    <section class="unit" id="{{SLUG}}" aria-labelledby="u{{NUM}}-title">
      <h2 class="unit-title" id="u{{NUM}}-title"><span class="unit-num" data-ui="video.n" data-n="{{NUM}}">影片 {{NUM}}</span><span data-i18n
        data-zh-hans="待填：影片标题"
        data-en="待填: video title"
        data-vi="待填: tiêu đề video">{{TITLE}}</span></h2>

      <div class="film">
        <div class="player">
          <video controls preload="metadata" playsinline data-hls="video/{{SLUG}}/hls/index.m3u8" poster="video/{{SLUG}}/poster.jpg" width="1920" height="1080">
            你的瀏覽器無法播放這支影片。
          </video>
        </div>
      </div>

      <ol class="chapters" aria-label="影片片段（點了直接跳到那一段）" data-ui-attr="aria-label:video.chapters">
        <li><button type="button" data-t="0"><span class="k">00:00</span><span class="t" data-i18n data-zh-hans="开场" data-en="Opening" data-vi="Mở đầu">開場</span></button></li>
      </ol>

      <ol class="points">
        <li><p data-i18n
          data-zh-hans="<strong>待填：重点一句话。</strong>待填：补一两句说明。"
          data-en="<strong>待填: the key point in one sentence.</strong> 待填: one or two sentences of explanation."
          data-vi="<strong>待填: ý chính trong một câu.</strong> 待填: một hai câu giải thích."><strong>待填：重點一句話。</strong>待填：補一兩句說明。</p></li>
      </ol>
    </section>
